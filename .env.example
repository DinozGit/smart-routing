# ─── API keys ───────────────────────────────────────────────────────────────
# Скопируй этот файл в .env и впиши свои ключи:
#   cp .env.example .env
#
# .env в .gitignore и НИКОГДА не попадает в репозиторий.
#
# Ключ OpenRouter: https://openrouter.ai/keys
# Ключ RouterAI:  https://routerai.ru
# Для локального Ollama ключ НЕ нужен (requires_api_key: false в config.yaml).

ROUTERAI_KEY=sk-ra-your-key-here
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ─── Optional ───────────────────────────────────────────────────────────────
# Таймауты и ретраи (см. README → Настройки транспорта)
# ROUTER_REQUEST_TIMEOUT=180
# ROUTER_CONNECT_TIMEOUT=20
# ROUTER_RETRY_ATTEMPTS=3
# ROUTER_RETRY_BACKOFF=0.7
